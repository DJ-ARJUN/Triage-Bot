# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*

# Database: Uses SQLite fallback by default for instant zero-config launch,
# or supply PostgreSQL URL: postgresql+asyncpg://postgres:postgres@localhost:5432/triage_db
DATABASE_URL=sqlite+aiosqlite:///./triage.db

# Authentication
SECRET_KEY=replace-with-a-long-random-private-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration (Optional: uses robust clinical rule-engine & triage summarizer if key not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage
UPLOAD_DIR=./uploads
SAMPLE_REPORTS_DIR=./sample_reports
MAX_UPLOAD_SIZE_MB=15

# Privacy & Compliance
ENABLE_PII_MASKING=true
RETENTION_DAYS_DEFAULT=30

